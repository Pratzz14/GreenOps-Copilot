{
  "name": "greenops-copilot-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GreenOps Copilot local React application",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "generate:api": "openapi-typescript ../outputs/openapi.json -o src/api/schema.ts",
    "test:dashboard": "node e2e/dashboard.cjs",
    "test:gold": "node e2e/gold.cjs",
    "test:workspace": "node e2e/analyst-workspace.cjs",
    "test:eda": "node e2e/analysis.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
